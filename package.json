{
  "name": "botrucho",
  "version": "2.2.0",
  "description": "",
  "main": "dist/src/sharder.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "oxlint src && eslint src && prettier --check src tests eslint.config.mjs tsconfig.json package.json",
    "lint:fix": "eslint src --fix && prettier --write src tests eslint.config.mjs tsconfig.json package.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run clean && swc src -d dist -s -D && node -e \"for(const name of ['assets','languages']) require('node:fs').cpSync(name,'dist/'+name,{recursive:true})\"",
    "start": "npm run build && dotenvx run --strict -e SHARDS=1 -f .env.development -- node -e \"process.chdir('dist');require(process.cwd()+'/src/sharder.js')\"",
    "test": "node --test \"tests/**/*.test.cjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.cjs\"",
    "test:integration": "node --test \"tests/integration/**/*.test.cjs\"",
    "test:contracts": "node --test \"tests/contracts/**/*.test.cjs\"",
    "test:platform": "node --test \"tests/platform/**/*.test.cjs\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discord-player/extractor": "7.2.0",
    "@discordjs/builders": "1.15.0",
    "@discordjs/rest": "2.6.3",
    "@dotenvx/dotenvx": "2.38.2",
    "@google/genai": "3.3.0",
    "@snazzah/davey": "0.1.12",
    "canvas": "3.2.3",
    "discord-api-types": "0.38.58",
    "discord-player": "7.2.0",
    "discord-player-googlevideo": "0.2.7",
    "discord-player-youtubei": "3.1.0",
    "discord-voip": "7.2.0",
    "discord.js": "14.28.1",
    "express": "5.3.0",
    "gif-encoder-2": "1.0.5",
    "jimp": "1.6.1",
    "mediaplex": "1.0.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "mongoose": "9.12.1",
    "node-cron": "4.6.0",
    "simple-ytdl-core": "1.2.2",
    "youtube-dl-exec": "3.1.19"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@eslint/js": "10.0.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
